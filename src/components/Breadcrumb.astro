---
import IconChevronLeft from "@/assets/icons/IconChevronLeft.svg";
import { buildBreadcrumbItems } from "@/utils/breadcrumbs";
import { getLangFromUrl, useTranslations, localizePath, stripLang } from "@/i18n/utils";

type Props = {
  withBackButton?: boolean;
  /** 当前页显示名称（例如文章标题），覆盖由路径推导出的名字 */
  currentLabel?: string;
};

const { withBackButton = false, currentLabel } = Astro.props as Props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const labels: Record<string, string> = {
  posts: t("nav.posts"),
  tags: t("nav.tags"),
  about: t("nav.about"),
  archives: t("nav.archives"),
  galleries: t("nav.galleries"),
  search: t("nav.search"),
};

// 先剥掉语言前缀，面包屑才是语言无关的路径
const breadcrumbs = buildBreadcrumbItems(stripLang(Astro.url.pathname), {
  locale: lang,
  labels,
  compactNumericPagination: true,
});

const items = currentLabel
  ? breadcrumbs.map((item, i) =>
      i === breadcrumbs.length - 1 ? { label: currentLabel, href: null } : item
    )
  : breadcrumbs;

const currentPageLabel = items.at(-1)?.label ?? t("breadcrumb.home");
---

<nav
  class:list={["app-layout mt-6 mb-2", { "overflow-hidden": withBackButton }]}
  aria-label={withBackButton ? "Contextual navigation" : "breadcrumb"}
>
  <div class:list={["flex items-center gap-3", { "justify-between": withBackButton }]}>
    {
      withBackButton && (
        <a
          id="back-button"
          href={localizePath("/", lang)}
          class="back-btn group flex-shrink-0 inline-flex items-center gap-1 text-sm text-foreground/55 transition-colors duration-200 hover:text-accent"
          aria-label={`${t("breadcrumb.goBack")} · ${currentPageLabel}`}
        >
          <IconChevronLeft class="size-4 opacity-70 transition-transform duration-200 group-hover:-translate-x-0.5 rtl:rotate-180" />
          <span>{t("breadcrumb.back")}</span>
        </a>
      )
    }

    <ol class="breadcrumb-list font-firacode text-sm">
      <li class="breadcrumb-item">
        <a
          href={localizePath("/", lang)}
          class="breadcrumb-link"
          aria-label={t("breadcrumb.home")}
          title={t("breadcrumb.home")}
        >
          {t("breadcrumb.home")}
        </a>
      </li>
      {
        items.map(item => (
          <li class:list={["breadcrumb-item", { "is-current": !item.href }]}>
            {item.href ? (
              <a href={localizePath(item.href, lang)} class="breadcrumb-link">
                {item.label}
              </a>
            ) : (
              <span class="breadcrumb-current" aria-current="page" title={item.label}>
                {item.label}
              </span>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</nav>

<style>
  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  /* 用 / 作分隔符，朴素文本，不再套边框和底色 */
  .breadcrumb-item + .breadcrumb-item::before {
    content: "/";
    margin-inline: 0.45rem;
    opacity: 0.35;
  }

  .breadcrumb-link,
  .breadcrumb-current {
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .breadcrumb-link {
    color: color-mix(in srgb, var(--foreground) 55%, transparent);
  }

  .breadcrumb-link:hover,
  .breadcrumb-link:focus-visible {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-underline-offset: 0.2em;
  }

  .breadcrumb-current {
    max-width: min(34ch, 64vw);
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--foreground);
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    .breadcrumb-link,
    .back-btn {
      transition: none;
    }
  }
</style>

{
  withBackButton && (
    <script>
      const BACK_BUTTON_SELECTOR = "#back-button";
      const FALLBACK_BACK_URL = "/";

      function toSafeBackPath(rawBackUrl: string | null) {
        if (!rawBackUrl) return FALLBACK_BACK_URL;

        try {
          const parsedUrl = new URL(rawBackUrl, window.location.origin);
          const isSameOrigin = parsedUrl.origin === window.location.origin;
          const isHttpProtocol =
            parsedUrl.protocol === "http:" || parsedUrl.protocol === "https:";

          if (!isSameOrigin || !isHttpProtocol) return FALLBACK_BACK_URL;

          return (
            `${parsedUrl.pathname}${parsedUrl.search}${parsedUrl.hash}` ||
            FALLBACK_BACK_URL
          );
        } catch {
          return FALLBACK_BACK_URL;
        }
      }

      function updateGoBackUrl() {
        const backButton = document.querySelector<HTMLAnchorElement>(
          BACK_BUTTON_SELECTOR
        );

        if (!backButton) return;

        const rawBackUrl = sessionStorage.getItem("backUrl");
        backButton.href = toSafeBackPath(rawBackUrl);
      }

      document.addEventListener("astro:page-load", updateGoBackUrl);
      updateGoBackUrl();
    </script>
  )
}
