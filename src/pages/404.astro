---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import { SITE } from "@/config";
import { DEFAULT_LANG } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";

const lang = DEFAULT_LANG;
const t = useTranslations(lang);
---

<Layout title={`404 | ${SITE.title}`}>
  <Header />

  <main
    id="main-content"
    class="app-layout flex flex-1 items-center justify-center"
  >
    <div class="mb-14 flex flex-col items-center justify-center">
      <h1 class="text-9xl font-bold text-accent">404</h1>
      <span aria-hidden="true">¯\_(ツ)_/¯</span>
      <p class="mt-4 text-2xl sm:text-3xl">{t("404.title")}</p>
      <p class="mt-2 opacity-60">{t("404.description")}</p>
      <LinkButton
        href={`/${lang}/`}
        class="my-6 text-lg underline decoration-dashed underline-offset-8"
      >
        {t("404.back")}
      </LinkButton>
    </div>
  </main>

  <Footer />
</Layout>
