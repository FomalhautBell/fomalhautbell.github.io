---
import AboutLayout from "@/layouts/AboutLayout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import { LANGS, type Lang } from "@/i18n/ui";


const placeholder: Record<Lang, string> = {
  "zh-CN": "这儿以后会写点关于自己的东西，先空着。",
  en: "Something about me will go here. Left blank for now.",
};

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<AboutLayout title={t("about.title")} description={t("about.description")}>
  <p class="opacity-60">{placeholder[lang]}</p>
</AboutLayout>
